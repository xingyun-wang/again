# 后端环境变量样例（M0 阶段）
# 拷贝到 .env 并按需修改

# 注：pip 镜像源是 build-time 优化（在 backend/Dockerfile 里），不在 runtime .env。
# 中国网络下默认 pypi.org 慢，Dockerfile 已加 --index-url https://mirrors.aliyun.com/pypi/simple/
# （Aliyun 镜像 ~5-10MB/s，build 压缩 50-100 倍）。CI（GitHub Actions）走官方源，
# 本 flag 仅 build-time 生效。

# 应用
APP_NAME=tiered-homework-backend
APP_VERSION=0.1.0
APP_ENV=development

# CORS（开发期允许本地前端；M1 收紧）
CORS_ORIGINS=http://localhost:5173,http://localhost

# 数据库（docker-compose 内置 PostgreSQL 15）
# 注：docker 内部用 postgres；本地直接跑改成 sqlite:///./dev.db 即可
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/tiered_homework

# Alembic（v0.5 §10 M1 起启用，docker-compose 启动链自动跑 alembic upgrade head）
# ALEMBIC_CONFIG=alembic.ini        # 默认值（生产用）
# ALEMBIC_SCRIPT_LOCATION=alembic   # 默认值
# DATABASE_URL 已在 # 数据库 段声明，alembic 用同一连接串
# 不要手动跑 alembic upgrade head —— compose 启动链自动跑（见 docker-compose.yml backend command）

# 日志（M0 retro #3 加的基建）
# LOG_LEVEL=INFO                    # DEBUG / INFO / WARNING / ERROR
# APP_ENV=development               # development / staging / production（控制 log 格式）

# LLM Provider（DeepSeek-V3）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding